# Single configuration file for the application, MinIO and Docker Compose.
# Copy to .env if absent; chmod 600 .env. Never commit the populated file.
APP__SECURITY__ADMIN_ID=
APP__TELEGRAM__TOKEN=
APP__TELEGRAM__USERNAME=
# polling: long polling; webhook: public HTTPS endpoint. Restart bot and API after changing.
APP__TELEGRAM__MODE=polling
APP__TELEGRAM__PUBLIC_URL=https://storage.example.com
# Generate independently of the MinIO password: openssl rand -hex 32
APP__TELEGRAM__WEBHOOK_SECRET=

# Local Android release signing only; never pass this key to the server containers.
# Keep mobile/android/.signing/storage-release.jks and this password for future APK updates.
STORAGE_ANDROID_KEYSTORE_PASSWORD=

# Garage access keys are provisioned separately; never use an administration secret here.
APP__FILE_STORAGE__USER=
APP__FILE_STORAGE__PASSWORD=
APP__FILE_STORAGE__ENDPOINT=garage:3900
APP__FILE_STORAGE__BUCKET=storage
APP__FILE_STORAGE__STAGING_BUCKET=storage-staging
APP__FILE_STORAGE__REGION=garage
APP__FILE_STORAGE__SECURE=false
APP__FILE_STORAGE__DISK_PATH=/storage-disk
APP__FILE_STORAGE__REQUIRE_MOUNT=true
APP__FILE_STORAGE__MIN_FREE_BYTES=1073741824

# Paths inside containers; relative paths resolve under /app.
APP__PERSISTENCE__DATABASE_PATH=var/storage.sqlite3
APP__MEDIA__TEMPORARY_DIRECTORY=var/temporary
APP__ASR__TEMPORARY_DIRECTORY=var/temporary
APP__SERVER__ENV=production
APP__SERVER__ENABLE_API_DOCS=false
APP__STORAGE__ARCHIVE_TIMEZONE=Europe/Minsk
APP__STORAGE__MAX_FILE_BYTES=10737418240
APP__STORAGE__PART_BYTES=8388608
APP__STORAGE__MAX_OPEN_UPLOADS=10

# RTX 2060 production settings. For CPU development set device=cpu, compute_type=int8.
APP__ASR__MODEL=small
APP__ASR__DEVICE=cuda
APP__ASR__COMPUTE_TYPE=int8_float16
APP__ASR__MAX_AUDIO_SECONDS=7200
HF_HOME=/app/cache/huggingface
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2

# Host paths used by production Compose. Mount the HDD first.
APP_DATA_DIR=/srv/storage/app
MODEL_CACHE_DIR=./var/cache
GARAGE_DATA_DIR=/mnt/storage/garage
GARAGE_SPACE_DIR=/mnt/storage/.app-space-check
GARAGE_CONFIG_FILE=./.server-setup/deploy/runtime/garage.toml
GARAGE_IMAGE=docker.io/dxflrs/garage@sha256:677e5b758e4425a325b811c425c026bf35a4bf42f7ddbaa773de3f4fd779a5a5
WORKER_MEMORY_LIMIT=4g
STORAGE_IMAGE=storage-app:local
STORAGE_WORKER_IMAGE=storage-worker:local

# Development Compose: use your id -u / id -g and create these directories first.
DEV_DATA_DIR=./var
DEV_UID=1000
DEV_GID=1000

# Private monitoring Compose; credentials stay in this same .env.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=${APP__SECURITY__ADMIN_ID}
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
GF_SECURITY_SECRET_KEY=
GF_SERVER_ROOT_URL=http://localhost:3000
GF_SECURITY_COOKIE_SECURE=false

# Docker daemon sends logs to the separately started monitoring Compose.
LOG_SYSLOG_ADDRESS=tcp://127.0.0.1:1514
